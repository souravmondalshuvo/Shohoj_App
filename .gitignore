app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase config — contains API keys, do not commit
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Firestore rules and indexes live in the Shohoj web repo, which is the single
# source of truth for them. Both repos deploy to the same Firebase project and
# a rules deploy replaces the whole ruleset, so these must never be deployed
# or committed from here.
firestore.rules
firestore.indexes.json
