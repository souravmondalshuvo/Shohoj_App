{
  "name": "shohoj-app-rules-tests",
  "private": true,
  "type": "module",
  "description": "Verifies that payloads this app writes are accepted by the Firestore rules the Shohoj web repo deploys.",
  "scripts": {
    "pretest": "node fetch-web-rules.mjs",
    "test": "firebase emulators:exec --only firestore --project shohoj-rules-test 'node --test'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.1.0",
    "firebase-tools": "^13.29.1"
  }
}
